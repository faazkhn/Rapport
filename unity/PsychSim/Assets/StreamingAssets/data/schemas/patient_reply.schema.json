{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Patient reply (DESIGN 7.2), ordered behaviour, emotion, utterance, reaction, intensity, resistance, ... so the voice can stream. doctor_intents comes from the parallel tagging request. The service builds a stricter per-request copy with enums.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "behaviour",
  "emotion",
  "utterance",
  "reaction",
  "intensity",
  "resistance",
  "state_delta",
  "event_cues",
  "revealed_fact_ids",
  "exam_action",
  "doctor_intents"
 ],
 "properties": {
  "behaviour": {
   "type": "string",
   "description": "Digital Twin behaviour id."
  },
  "emotion": {
   "enum": [
    "neutral",
    "sad",
    "anxious",
    "angry",
    "ashamed",
    "happy",
    "flat",
    "suspicious",
    "confused"
   ]
  },
  "utterance": {
   "type": "string"
  },
  "reaction": {
   "type": "string",
   "description": "Digital Twin reaction id (data/brain/behaviours.json)."
  },
  "intensity": {
   "type": "integer",
   "minimum": 0,
   "maximum": 10
  },
  "resistance": {
   "type": "string",
   "description": "Digital Twin resistance id."
  },
  "state_delta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trust",
    "distress",
    "agitation",
    "engagement"
   ],
   "properties": {
    "trust": {
     "type": "integer"
    },
    "distress": {
     "type": "integer"
    },
    "agitation": {
     "type": "integer"
    },
    "engagement": {
     "type": "integer"
    }
   }
  },
  "event_cues": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "intensity",
     "duration_s"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "intensity": {
      "type": "number"
     },
     "duration_s": {
      "type": "number"
     }
    }
   }
  },
  "revealed_fact_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "exam_action": {
   "enum": [
    null,
    "hold_out_hands",
    "roll_up_sleeves",
    "look_at_light",
    "stand_up",
    "walk_to_door"
   ]
  },
  "doctor_intents": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}