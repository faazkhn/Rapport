{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Diagnoses", "type": "object", "required": ["version", "status", "diagnoses"],
  "properties": { "version": { "type": "string" }, "status": { "enum": ["draft", "faculty_review", "approved"] }, "note": { "type": "string" },
    "diagnoses": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "dsm5tr_name", "icd11", "verified_by"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "dsm5tr_name": { "type": "string" }, "icd11": { "type": "string" }, "icd10": { "type": "string" }, "verified_by": { "type": ["string", "null"] } } } } } }
