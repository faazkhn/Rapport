{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Case file (DESIGN 6.1)", "type": "object", "additionalProperties": false,
  "required": ["id", "title", "version", "status", "authors", "reviewed_by", "setting", "referral_note", "patient", "state_start", "facts", "cues", "fallback_lines", "answer_key"],
  "$defs": {
    "pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "gain": { "type": "number", "minimum": -1, "maximum": 1 },
    "mse_entry": { "type": "object", "additionalProperties": false, "properties": { "cues": { "$ref": "#/$defs/ids" }, "note": { "type": "string" } } }
  },
  "properties": {
    "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "version": { "type": "string" }, "status": { "enum": ["draft", "faculty_review", "approved"] },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "reviewed_by": { "type": "array", "items": { "type": "string" } }, "verified_by": { "type": ["string", "null"] },
    "setting": { "enum": ["outpatient_consult", "emergency_bay", "detox_ward", "community_clinic"] },
    "time_limit_min": { "type": "number", "exclusiveMinimum": 0 },
    "content_note": { "type": "string" },
    "referral_note": { "type": "string", "minLength": 1 },
    "patient": { "type": "object", "additionalProperties": false,
      "required": ["name", "age", "sex", "model_id", "voice_id", "voice_speed", "personality"],
      "properties": { "name": { "type": "string" }, "age": { "type": "integer", "minimum": 0, "maximum": 120 }, "sex": { "enum": ["female", "male", "other"] },
        "model_id": { "type": "string" }, "variant": { "type": "string" },
        "voice_id": { "enum": ["Bella", "Luna", "Rosie", "Kiki", "Jasper", "Bruno", "Hugo", "Leo"] },
        "voice_speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "background": { "type": "string" }, "personality": { "type": "string" }, "speech_style": { "type": "string" } } },
    "state_start": { "type": "object", "additionalProperties": false, "required": ["trust", "distress", "agitation", "engagement"], "properties": { "trust": { "$ref": "#/$defs/pct" }, "distress": { "$ref": "#/$defs/pct" }, "agitation": { "$ref": "#/$defs/pct" }, "engagement": { "$ref": "#/$defs/pct" } } },
    "state_drift_per_min": { "type": "object", "additionalProperties": false, "properties": { "trust": { "type": "number" }, "distress": { "type": "number" }, "agitation": { "type": "number" }, "engagement": { "type": "number" } } },
    "facts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "text", "trust_min"],
      "properties": { "id": { "type": "string", "pattern": "^f_[a-z0-9_]+$" }, "text": { "type": "string", "minLength": 1 }, "trust_min": { "$ref": "#/$defs/pct" },
        "volunteered": { "type": "boolean" }, "unlock_intents": { "$ref": "#/$defs/ids" },
        "must_be_asked": { "type": "boolean", "description": "Only revealed on a turn tagged with one of unlock_intents; never volunteered." } } } },
    "cues": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "base"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "base": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust_gain": { "$ref": "#/$defs/gain" }, "distress_gain": { "$ref": "#/$defs/gain" }, "agitation_gain": { "$ref": "#/$defs/gain" }, "engagement_gain": { "$ref": "#/$defs/gain" },
        "time_gain_per_min": { "type": "number" }, "on_facts": { "type": "array", "items": { "type": "string" } },
        "event_boost": { "type": "number", "minimum": 0, "maximum": 1 }, "event_duration_s": { "type": "number", "minimum": 0 } } } },
    "exam": { "type": "object" },
    "scales": { "type": "object", "additionalProperties": { "type": "object", "required": ["item_scores"],
      "properties": { "item_scores": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } } },
    "fallback_lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "answer_key": { "type": "object", "additionalProperties": false,
      "required": ["primary_dx", "acceptable_differentials", "required_intents", "required_cues_noted", "acceptable_rx", "unsafe_rx", "acceptable_disposition", "teaching_points"],
      "properties": {
        "primary_dx": { "$ref": "#/$defs/ids", "minItems": 1 }, "specifiers_note": { "type": "string" },
        "acceptable_differentials": { "$ref": "#/$defs/ids" }, "required_intents": { "$ref": "#/$defs/ids" }, "required_cues_noted": { "$ref": "#/$defs/ids" },
        "acceptable_rx": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["drug"],
          "properties": { "drug": { "$ref": "#/$defs/id" }, "required": { "type": "boolean" }, "note": { "type": "string" } } } },
        "unsafe_rx": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["rule", "why"],
          "properties": { "drug": { "type": "string" }, "drug_class": { "type": "string" }, "rule": { "$ref": "#/$defs/id" }, "why": { "type": "string" } } } },
        "acceptable_disposition": { "$ref": "#/$defs/ids", "minItems": 1 }, "required_disposition": { "$ref": "#/$defs/ids" },
        "teaching_points": { "type": "object", "additionalProperties": false, "required": ["status", "verified_by", "items"],
          "properties": { "status": { "enum": ["draft", "faculty_review", "approved"] }, "verified_by": { "type": ["string", "null"] }, "items": { "type": "array", "items": { "type": "string" } } } },
        "mse_expected": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mse_entry" } } } } } }
