{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "State rules", "type": "object", "required": ["version", "status", "clamp_per_turn", "range", "intent_nudges"],
  "$defs": { "delta": { "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "trust": { "type": "number", "minimum": -100, "maximum": 100 }, "distress": { "type": "number", "minimum": -100, "maximum": 100 }, "agitation": { "type": "number", "minimum": -100, "maximum": 100 }, "engagement": { "type": "number", "minimum": -100, "maximum": 100 } } } },
  "properties": { "version": { "type": "string" }, "status": { "enum": ["draft", "faculty_review", "approved"] }, "note": { "type": "string" },
    "clamp_per_turn": { "type": "number", "exclusiveMinimum": 0 },
    "reaction_trust_unit": { "type": "number", "minimum": 0, "maximum": 5, "description": "Trust change per step of a Digital Twin reaction's trust_step." },
    "mood_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Share of the way the PAD mood moves toward its target each turn." },
    "exam_refuse_agitation": { "type": "number", "minimum": 0, "maximum": 100, "description": "At or above this agitation the patient refuses every exam action." },
    "range": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
    "intent_nudges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/delta" } } } }
