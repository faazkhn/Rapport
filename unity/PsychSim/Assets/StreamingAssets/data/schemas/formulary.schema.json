{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Formulary", "type": "object", "required": ["version", "status", "rules", "drugs"],
  "properties": { "version": { "type": "string" }, "status": { "enum": ["draft", "faculty_review", "approved"] }, "note": { "type": "string" },
    "rules": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "severity", "description"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "kind": { "enum": ["contraindication", "interaction", "requirement"] }, "severity": { "enum": ["critical", "safety", "minor"] }, "description": { "type": "string" } } } },
    "drugs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "name", "class", "routes", "dose_range_mg", "usual_start_mg", "contraindication_rules", "interaction_rules", "nlem_2022", "source", "verified_by"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "name": { "type": "string" }, "class": { "type": "string" },
        "routes": { "type": "array", "minItems": 1, "items": { "enum": ["PO", "IV", "IM", "SC", "SL", "TD", "PR"] } },
        "dose_range_mg": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": ["number", "null"] }, "max": { "type": ["number", "null"] } } },
        "usual_start_mg": { "type": ["number", "null"] },
        "contraindication_rules": { "type": "array", "items": { "type": "string" } },
        "interaction_rules": { "type": "array", "items": { "type": "string" } },
        "nlem_2022": { "type": ["boolean", "null"] }, "source": { "type": ["string", "null"] }, "verified_by": { "type": ["string", "null"] } } } } } }
